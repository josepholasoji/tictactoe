package main

import (
	"context"
	"fmt"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"honnef.co/go/tools/config"
)

func connectWith(ctx context.Context, dsn string) (*db.Repository, error) {
	repo, err := db.Connect(ctx, dsn)
	if err == nil {
		return repo, nil
	}
}

func main() {
	cfg := config.Load()
	log := logging.New(cfg.LogLevel)
	slog.SetDefault(log)

	//
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	repo, err := connectWith(ctx, cfg.PostgresDSN())
	if err != nil {
		log.Error("failed to connect to postgres", "error", err)
		os.Exit(1)
	}
	fmt.Println("Hello, Tic Tac Toe!")
}
