{
  "uid": "tictactoe-performance",
  "title": "Performance",
  "tags": ["tictactoe"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "rate(process_cpu_seconds_total{job=\"tictactoe-server\"}[5m])", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"tictactoe-server\"}", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "go_goroutines{job=\"tictactoe-server\"}", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Database Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tictactoe_database_latency_seconds_bucket[5m])) by (le, operation))",
          "refId": "A",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "WebSocket Message Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tictactoe_ws_message_latency_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Average WebSocket Message Latency",
      "type": "timeseries",
      "description": "Mean latency, i.e. rate(sum)/rate(count) - distinct from the p95 panel above.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(tictactoe_ws_message_latency_seconds_sum[5m]) / rate(tictactoe_ws_message_latency_seconds_count[5m])",
          "refId": "A",
          "legendFormat": "avg latency"
        }
      ]
    },
    {
      "id": 7,
      "title": "Average Database Latency",
      "type": "timeseries",
      "description": "Mean latency across all PostgreSQL operations, i.e. rate(sum)/rate(count) - distinct from the p95 panel above.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(tictactoe_database_latency_seconds_sum[5m])) / sum(rate(tictactoe_database_latency_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "avg latency"
        }
      ]
    }
  ]
}
